# Copie este arquivo para .env localmente e preencha os valores na sua máquina.
# Nunca versione o .env nem credenciais reais.

PGHOST=localhost
PGPORT=5432
PGDATABASE=dw_joalheria
PGUSER=postgres
PGPASSWORD=ALTERE_LOCALMENTE
PGSSLMODE=prefer

# Opcional: pasta do psql quando ele não estiver no PATH (PostgreSQL 18 já instalado).
# Exemplo: C:\Program Files\PostgreSQL\18\bin
PG_BIN=
