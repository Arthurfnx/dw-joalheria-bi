# Copie este arquivo para .env localmente e preencha os valores na sua máquina.
# Nunca versione o .env nem credenciais reais.

PGHOST=localhost
PGPORT=5432
PGDATABASE=dw_joalheria
PGUSER=postgres
PGPASSWORD=ALTERE_LOCALMENTE
PGSSLMODE=prefer

# Opcional: pasta do psql quando ele não estiver no PATH (PostgreSQL 18 já instalado).
# Exemplo: C:\Program Files\PostgreSQL\18\bin
PG_BIN=

# ETL do DW real (scripts/run_etl_app.ps1): leitura do banco operacional.
# Só o papel nobreza_leitura_dw (sem acesso a nomes de pessoas). Host e porta
# vazios = os mesmos do DW; banco e usuário vazios = nobreza_app e nobreza_leitura_dw.
APP_PGHOST=
APP_PGPORT=
APP_PGDATABASE=nobreza_app
APP_PGUSER=nobreza_leitura_dw
APP_PGPASSWORD=ALTERE_LOCALMENTE
