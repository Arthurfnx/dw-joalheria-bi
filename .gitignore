# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local source files and derived business data (never commit raw client data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

docs/referencia/*
!docs/referencia/.gitkeep

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs and temporary files
*.log
*.tmp
.DS_Store
Thumbs.db

# Local database files and backups
*.dump
*.backup
*.bak
*.sqlite
*.db
*.sql.gz

# Power BI local binary project files (DAX and documentation can be versioned)
*.pbix

# Claude local settings and working state
.claude/settings.local.json
.claude/worktrees/

# IDE / OS
.vscode/
.idea/

# Power BI PBIP: configurações locais e cache de dados (não versionar)
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Memória e instruções pessoais do Claude Code
/CLAUDE.md
