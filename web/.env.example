# Copie para web/.env e preencha. O arquivo web/.env não é versionado.
# Formato das cadeias de conexão: postgresql://PAPEL:SENHA@localhost:5432/BANCO

# Conexão da aplicação (papel nobreza_aplicacao, banco nobreza_app)
DATABASE_URL=

# Conexão das migrations (papel nobreza_migracao, banco nobreza_app)
DATABASE_URL_MIGRACAO=

# Testes de integração: papel nobreza_aplicacao no banco nobreza_app_teste
DATABASE_URL_TESTE=

# Testes de integração: papel nobreza_migracao no banco nobreza_app_teste
DATABASE_URL_TESTE_MIGRACAO=

# Leitura para o ETL do DW (papel nobreza_leitura_dw, banco nobreza_app).
# Os testes usam o mesmo papel no banco nobreza_app_teste.
DATABASE_URL_LEITURA_DW=

# Link público do painel do Grafana Cloud: https://<pilha>.grafana.net/public-dashboards/<token>
PAINEL_URL=

# Leitura do Data Warehouse para os gráficos da tela Relatórios (papel bi_leitura, banco dw_joalheria,
# só leitura do esquema bi). Vazia: a seção de gráficos informa que o DW não está configurado.
DW_DATABASE_URL=
